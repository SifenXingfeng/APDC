entity = {
  name = "APDC_b2_light_tank_entity"
  pdxmesh = "APDC_b2_light_tank_mesh"
  scale = 0.5
  state = { name = "idle" animation = "idle" animation_blend_time = 0.2
  }
  state = { name = "move" animation = "move" animation_blend_time = 0.2
    event = { time = 0 node = "left_tracks" particle = "tank_moving_tracks_particle" keep_particle = no trigger_once = yes }
    event = { time = 0 node = "right_tracks" particle = "tank_moving_tracks_particle" keep_particle = no trigger_once = yes }
  }
  state = { name = "retreat" animation = "move" animation_blend_time = 0.2
