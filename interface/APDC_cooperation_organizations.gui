guiTypes = {
	# Reusable dynamic-list template for the single chair-country scope.
	# The 82x52 flag is placed at +9,+9 inside the supplied 100x70 frame.
	containerWindowType = {
		name = "APDC_cooperation_organization_chair_entry"
		size = { width = 294 height = 340 }
		clipping = no

		iconType = {
			name = "APDC_cooperation_organization_chair_flag"
			# Plain masked flags use their center as the GUI origin.  These
			# coordinates preserve the original 82x52 flag rectangle at 106,37.
			position = { x = 147 y = 63 }
			quadTextureSprite = "GFX_APDC_cooperation_organization_flag_medium_unfiltered"
			alwaystransparent = yes
		}
		iconType = {
			name = "APDC_cooperation_organization_chair_frame"
			position = { x = 97 y = 28 }
			spriteType = "GFX_APDC_cooperation_organization_chair_frame"
			alwaystransparent = yes
		}
		instantTextboxType = {
			name = "APDC_cooperation_organization_chair_title"
			# The 100x70 frame ends at y=98.  A title y of 120 leaves 22px,
			# matching the 22px gap between this 42px box and the name below.
			position = { x = 0 y = 120 }
			font = "hoi_36header"
			text = "APDC_COOPERATION_ORGANIZATION_CHAIR_TITLE"
			maxWidth = 294
			maxHeight = 42
			fixedsize = yes
			format = center
			vertical_alignment = center
			alwaystransparent = yes
		}
		instantTextboxType = {
			name = "APDC_cooperation_organization_chair_country_name"
			position = { x = 0 y = 184 }
			font = "hoi_24header"
			text = "APDC_COOPERATION_ORGANIZATION_CHAIR_COUNTRY_NAME"
			maxWidth = 294
			maxHeight = 30
			fixedsize = yes
			format = center
			vertical_alignment = center
			alwaystransparent = yes
		}
	}

	# Reusable entry for every member-country scope in the dynamic array.
	# The 41x26 flag is placed at +2,+2 inside either 45x30 frame.
	containerWindowType = {
		name = "APDC_cooperation_organization_member_entry"
		size = { width = 65 height = 58 }
		clipping = no

		iconType = {
			name = "APDC_cooperation_organization_member_flag"
			# Preserve the original 41x26 flag rectangle at 12,2.
			position = { x = 33 y = 15 }
			quadTextureSprite = "GFX_APDC_cooperation_organization_flag_small_unfiltered"
			alwaystransparent = yes
		}
		iconType = {
			name = "APDC_cooperation_organization_member_frame"
			position = { x = 10 y = 0 }
			spriteType = "GFX_APDC_cooperation_organization_member_frame"
			alwaystransparent = yes
		}
		iconType = {
			name = "APDC_cooperation_organization_player_member_frame"
			position = { x = 10 y = 0 }
			spriteType = "GFX_APDC_cooperation_organization_player_member_frame"
			alwaystransparent = yes
		}
		buttonType = {
			name = "APDC_cooperation_organization_member_tooltip"
			position = { x = 10 y = 0 }
			size = { x = 45 y = 30 }
			spriteType = "GFX_APDC_cooperation_organization_member_hitbox"
			pdx_tooltip = "APDC_COOPERATION_ORGANIZATION_MEMBER_TOOLTIP"
		}
	}

	# Diplomacy-panel member row.  It deliberately reuses the organization
	# panel's 41x26 shield flag and both supplied 45x30 frames.  Scripted-GUI
	# visibility swaps the ordinary frame for the highlighted frame on the
	# chair country.
	containerWindowType = {
		name = "APDC_diplomacy_cooperation_organization_member_entry"
		size = { width = 290 height = 48 }
		clipping = yes

		background = {
			name = "APDC_diplomacy_cooperation_organization_member_background"
			spriteType = "GFX_diplo_countrylist_entry"
		}

		iconType = {
			name = "APDC_diplomacy_cooperation_organization_member_flag"
			position = { x = 33 y = 23 }
			quadTextureSprite = "GFX_APDC_cooperation_organization_flag_small_unfiltered"
			alwaystransparent = yes
		}
		iconType = {
			name = "APDC_diplomacy_cooperation_organization_member_frame"
			position = { x = 10 y = 8 }
			spriteType = "GFX_APDC_cooperation_organization_member_frame"
			alwaystransparent = yes
		}
		iconType = {
			name = "APDC_diplomacy_cooperation_organization_chair_frame"
			position = { x = 10 y = 8 }
			spriteType = "GFX_APDC_cooperation_organization_player_member_frame"
			alwaystransparent = yes
		}
		instantTextboxType = {
			name = "APDC_diplomacy_cooperation_organization_member_name"
			position = { x = 68 y = 9 }
			font = "hoi_18mbs"
			text = "[THIS.GetName]"
			maxWidth = 205
			maxHeight = 30
			fixedsize = yes
			format = left
			vertical_alignment = center
			alwaystransparent = yes
		}
	}

	# One reusable 70px row: a 50px law background plus the requested 20px
	# nearest-pixel gap before the following row.  Four 160px choices use the
	# exact positions from the supplied mock-up; 2/3-option groups hide extras.
