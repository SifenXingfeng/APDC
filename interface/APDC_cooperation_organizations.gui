		name = "APDC_cooperation_law_group_entry"
		size = { width = 1010 height = 70 }
		clipping = no

		iconType = { name = "APDC_cooperation_law_group_background" position = { x = 35 y = 0 } spriteType = "GFX_APDC_cooperation_law_group_background" alwaystransparent = yes }
