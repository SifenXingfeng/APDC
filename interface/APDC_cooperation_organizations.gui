			gridBoxType = { name = "APDC_cooperation_vote_support_list" position = { x = 0 y = 0 } size = { width = 141 height = 74 } slotsize = { width = 47 height = 34 } add_horizontal = yes max_slots_horizontal = 3 format = "UPPER_LEFT" }
		}
