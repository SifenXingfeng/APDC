		}

		# Base tabs: above the main panel, below the lower page plate.
		# The source tab is already alpha-tight (211x71), so its crop
		# compensation is (0,0).  Five 211px spans give the intended
		# 1055px non-transparent strip.
		buttonType = {
			name = "APDC_cooperation_organization_tab_1"
			position = { x = 11 y = 409 }
			size = { x = 211 y = 71 }
			spriteType = "GFX_APDC_cooperation_organization_panel_tab"
			clicksound = click_default
		}
		buttonType = {
			name = "APDC_cooperation_organization_tab_2"
			position = { x = 222 y = 409 }
			size = { x = 211 y = 71 }
			spriteType = "GFX_APDC_cooperation_organization_panel_tab"
			clicksound = click_default
		}
		buttonType = {
