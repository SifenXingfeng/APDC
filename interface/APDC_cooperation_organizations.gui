		buttonType = { name = "APDC_cooperation_law_option_2_button" position = { x = 426 y = 7 } size = { x = 160 y = 36 } spriteType = "GFX_APDC_cooperation_law_option_hitbox" clicksound = click_default pdx_tooltip = "APDC_COOPERATION_LAW_OPTION_2_TOOLTIP" }

		iconType = { name = "APDC_cooperation_law_option_3_available" position = { x = 616 y = 7 } spriteType = "GFX_APDC_cooperation_law_option_available" alwaystransparent = yes }
		iconType = { name = "APDC_cooperation_law_option_3_selected" position = { x = 616 y = 7 } spriteType = "GFX_APDC_cooperation_law_option_selected" alwaystransparent = yes }
		iconType = { name = "APDC_cooperation_law_option_3_unavailable" position = { x = 616 y = 7 } spriteType = "GFX_APDC_cooperation_law_option_unavailable" alwaystransparent = yes }
		instantTextboxType = { name = "APDC_cooperation_law_option_3_name" position = { x = 616 y = 8 } font = "vic_18_black" text = "APDC_COOPERATION_LAW_OPTION_3_NAME" maxWidth = 160 maxHeight = 28 fixedsize = yes format = center vertical_alignment = center alwaystransparent = yes }
		buttonType = { name = "APDC_cooperation_law_option_3_button" position = { x = 616 y = 7 } size = { x = 160 y = 36 } spriteType = "GFX_APDC_cooperation_law_option_hitbox" clicksound = click_default pdx_tooltip = "APDC_COOPERATION_LAW_OPTION_3_TOOLTIP" }

		iconType = { name = "APDC_cooperation_law_option_4_available" position = { x = 806 y = 7 } spriteType = "GFX_APDC_cooperation_law_option_available" alwaystransparent = yes }
