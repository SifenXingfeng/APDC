		buttonType = { name = "APDC_cooperation_law_option_1_button" position = { x = 236 y = 7 } size = { x = 160 y = 36 } spriteType = "GFX_APDC_cooperation_law_option_hitbox" clicksound = click_default pdx_tooltip = "APDC_COOPERATION_LAW_OPTION_1_TOOLTIP" }

		iconType = { name = "APDC_cooperation_law_option_2_available" position = { x = 426 y = 7 } spriteType = "GFX_APDC_cooperation_law_option_available" alwaystransparent = yes }
		iconType = { name = "APDC_cooperation_law_option_2_selected" position = { x = 426 y = 7 } spriteType = "GFX_APDC_cooperation_law_option_selected" alwaystransparent = yes }
