			position = { x = 855 y = 409 }
			size = { x = 211 y = 71 }
			spriteType = "GFX_APDC_cooperation_organization_panel_tab"
			clicksound = click_default
		}

		# 1075px is centered inside the 1078px panel with the unavoidable
		# half-pixel difference rounded left.  Bottom edges meet at y=972.
		iconType = {
			name = "APDC_cooperation_organization_panel_lower"
			position = { x = 1 y = 409 }
			spriteType = "GFX_APDC_cooperation_organization_panel_lower"
			alwaystransparent = yes
		}

		# Shared lower-page law list.  Tab clicks replace the numeric source
		# array; the same reusable row renders all five categories.
		containerWindowType = {
			name = "APDC_cooperation_law_group_scroll"
			# The lower plate's first non-transparent row is at panel y=471.
			# With the grid's 20px inset, y=472 leaves exactly 20 blank pixel
			# rows before the first law background and preserves the old bottom.
			position = { x = 14 y = 472 }
			size = { width = 1050 height = 480 }
			clipping = yes
			verticalScrollbar = "right_vertical_slider"
			autohide_scrollbars = yes
			scroll_wheel_factor = 70
			smooth_scrolling = yes
			margin = { top = 0 right = 18 bottom = 0 }
			background = { name = "APDC_cooperation_law_group_scroll_background" spriteType = "GFX_tiled_window_transparent" }
			gridBoxType = {
				name = "APDC_cooperation_law_group_list"
				position = { x = 0 y = 20 }
				size = { width = 1010 height = 100% }
				slotsize = { width = 1010 height = 70 }
				max_slots_horizontal = 1
				format = "UPPER_LEFT"
			}
		}

		# Active-tab copies: above the lower plate.  Scripted-GUI visibility
		# ensures exactly one of these five copies is drawn.
		iconType = { name = "APDC_cooperation_organization_tab_1_active" position = { x = 11 y = 409 } spriteType = "GFX_APDC_cooperation_organization_panel_tab" alwaystransparent = yes }
		iconType = { name = "APDC_cooperation_organization_tab_2_active" position = { x = 222 y = 409 } spriteType = "GFX_APDC_cooperation_organization_panel_tab" alwaystransparent = yes }
		iconType = { name = "APDC_cooperation_organization_tab_3_active" position = { x = 433 y = 409 } spriteType = "GFX_APDC_cooperation_organization_panel_tab" alwaystransparent = yes }
		iconType = { name = "APDC_cooperation_organization_tab_4_active" position = { x = 644 y = 409 } spriteType = "GFX_APDC_cooperation_organization_panel_tab" alwaystransparent = yes }
		iconType = { name = "APDC_cooperation_organization_tab_5_active" position = { x = 855 y = 409 } spriteType = "GFX_APDC_cooperation_organization_panel_tab" alwaystransparent = yes }

		instantTextboxType = { name = "APDC_cooperation_organization_tab_1_label" position = { x = 11 y = 427 } font = "hoi_20b" text = "APDC_COOPERATION_TAB_ORGANIZATION" maxWidth = 211 maxHeight = 30 format = center alwaystransparent = yes }
		instantTextboxType = { name = "APDC_cooperation_organization_tab_2_label" position = { x = 222 y = 427 } font = "hoi_20b" text = "APDC_COOPERATION_TAB_ECONOMY" maxWidth = 211 maxHeight = 30 format = center alwaystransparent = yes }
		instantTextboxType = { name = "APDC_cooperation_organization_tab_3_label" position = { x = 433 y = 427 } font = "hoi_20b" text = "APDC_COOPERATION_TAB_RESEARCH" maxWidth = 211 maxHeight = 30 format = center alwaystransparent = yes }
		instantTextboxType = { name = "APDC_cooperation_organization_tab_4_label" position = { x = 644 y = 427 } font = "hoi_20b" text = "APDC_COOPERATION_TAB_MILITARY" maxWidth = 211 maxHeight = 30 format = center alwaystransparent = yes }
		instantTextboxType = { name = "APDC_cooperation_organization_tab_5_label" position = { x = 855 y = 427 } font = "hoi_20b" text = "APDC_COOPERATION_TAB_INTELLIGENCE" maxWidth = 211 maxHeight = 30 format = center alwaystransparent = yes }

		buttonType = {
			name = "APDC_cooperation_organization_panel_close"
			position = { x = -50 y = 12 }
			quadTextureSprite = "GFX_closebutton"
			Orientation = "UPPER_RIGHT"
			shortcut = "ESCAPE"
			clicksound = click_close
			pdx_tooltip = "APDC_COOPERATION_ORGANIZATION_PANEL_CLOSE_TOOLTIP"
		}
