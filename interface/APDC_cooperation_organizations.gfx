	}

	# Neutral fallback for a newly-created container until a dedicated icon is
	# registered in APDCCooperationOrganizationIcon.
	spriteType = {
		name = "GFX_APDC_cooperation_organization_generic"
		textureFile = "gfx/interface/APDC/cooperation_organizations/no_cooperation_organization.dds"
	}

	# Cooperation-organization flags use a transparent textureFile1 to remove the vanilla
	# scanline/drape overlay while textureFile2 keeps the rectangular mask.
	# Small flags use an APDC shader that clamps sampling to their own atlas cell;
	# APDC frames remain separate GUI layers.
	# GUI users explicitly set centerposition = yes to preserve the center origin
	# used by the former overlay-free shields.
	maskedShieldType = {
		name = "GFX_APDC_cooperation_organization_flag_medium_unfiltered"
		textureFile1 = "gfx/interface/APDC/cooperation_organizations/transparent_overlay_medium.tga"
		textureFile2 = "gfx/interface/shield_medium_mask.tga"
		effectFile = "gfx/FX/maskedflag.lua"
	}

	maskedShieldType = {
